# --- Environnement virtuel ------------------------------------------------- #
.venv/
venv/
env/

# --- Python : bytecode et caches ------------------------------------------- #
__pycache__/
*.py[cod]
# Cache Numba (cache=True) : fichiers .nbi / .nbc, normalement dans __pycache__
*.nbi
*.nbc

# --- Installation du paquet (pip install -e .) ----------------------------- #
*.egg-info/
build/
dist/

# --- Tests ----------------------------------------------------------------- #
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Sorties générées par les scripts (régénérables) ----------------------- #
# valider_pricer.py, valider_lsm.py, valider_dividendes.py
rapport_*.csv
# valider_marche.py
resultats_marche_*.csv
svi_params_*.csv
smiles_*.png
chaine_*.csv
dividendes_*.csv
