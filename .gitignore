chaine_test.csv
dividendes_test.csv

# --- Éditeurs ------------------------------------------------------------- #
.vscode/
.idea/

# --- Systèmes d'exploitation ---------------------------------------------- #
Thumbs.db
desktop.ini
.DS_Store

